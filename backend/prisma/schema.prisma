generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Inscricao {
  id                       Int      @id @default(autoincrement())
  fullName                 String
  birthDate                String
  city                     String
  phone                    String
  email                    String
  sportsExperience         String?
  rugbyExperience          Boolean  @default(false)
  wheelchairUser           Boolean  @default(false)
  functionalClassification String?
  functionalInformation    String?
  message                  String?
  privacyAccepted          Boolean  @default(false)
  status                   String   @default("PENDIENTE")
  createdAt                DateTime @default(now())
}

model Patrocinio {
  id              Int                   @id @default(autoincrement())
  companyName     String
  contactName     String
  email           String
  phone           String?
  sponsorshipType String
  message         String?
  status          String                @default("PENDIENTE")
  createdAt       DateTime              @default(now())
  financeiro      PatrocinioFinanciero?
}

model Jogador {
  id             Int                   @id @default(autoincrement())
  name           String
  role           String
  classification String?
  nationality    String
  image          String?
  bio            String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  pagamentos     PagamentoCuota[]
  participacoes  ParticipanteJornada[]
}

model Evento {
  id          Int               @id @default(autoincrement())
  type        String
  name        String
  date        String?
  month       String?
  year        String?    
  day         String?
  time        String
  location    String
  description String?
  isPublic    Boolean           @default(false)
  isActive    Boolean           @default(true)

  // Estado real del evento
  status      String            @default("PROGRAMADO")
  completedAt DateTime?

  createdAt   DateTime          @default(now())
  inscricoes  InscricaoEvento[]
  fotos       EventoFoto[]
}

model EventoFoto {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String?
  createdAt DateTime @default(now())

  eventoId  Int
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model InscricaoEvento {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  message   String?
  eventId   Int
  createdAt DateTime @default(now())
  evento    Evento   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Jornada {
  id            Int                   @id @default(autoincrement())
  numero        String
  competicion   String
  ciudad        String
  pabellon      String
  fechas        String
  bannerUrl     String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  temporadaId   Int?
  gastos        Gasto[]
  ingressos     Ingresso[]
  temporada     Temporada?            @relation(fields: [temporadaId], references: [id])
  participantes ParticipanteJornada[]
  partidos      Partido[]
}

model Partido {
  id                    Int     @id @default(autoincrement())
  jornadaId             Int
  rival                 String?
  diaSemana             String
  horario               String
  youtubeLink           String?
  lobosScore            Int?
  rivalScore            Int?
  status                String  @default("PROGRAMADO")
  equipoLocalLogo       String?
  equipoLocalNombre     String?
  equipoVisitanteLogo   String?
  equipoVisitanteNombre String?
  fecha                 String?
  rivalLogo             String?
  jornada               Jornada @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
}

model Subvencion {
  id             Int      @id @default(autoincrement())
  ano            Int
  valor          String
  entidad        String
  fechaConcesion String
  tipo           String
  ambito         String
  departamento   String?
  convocatoria   String?
  basesLink      String?
  createdAt      DateTime @default(now())
  financeiro     SubvencionFinanceira?
}

model Temporada {
  id             Int                    @id @default(autoincrement())
  nome           String
  dataInicio     DateTime
  dataFim        DateTime
  saldoInicial   Float                  @default(0)
  cuotaMensual   Float
  estado         String                 @default("ACTIVA")
  createdAt      DateTime               @default(now())
  cuotas         Cuota[]
  gastos         Gasto[]
  ingressos      Ingresso[]
  jornadas       Jornada[]
  pagamentos     PagamentoCuota[]
  participantes  ParticipanteJornada[]
  patrociniosFin PatrocinioFinanciero[]
  subvencoesFin  SubvencionFinanceira[]
}

model Cuota {
  id          Int              @id @default(autoincrement())
  temporadaId Int
  mes         Int
  anio        Int
  importe     Float
  createdAt   DateTime         @default(now())
  temporada   Temporada         @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  pagamentos  PagamentoCuota[]

  @@unique([temporadaId, mes, anio])
}

model PagamentoCuota {
  id           Int       @id @default(autoincrement())
  jogadorId    Int
  cuotaId      Int
  temporadaId  Int
  importePago  Float     @default(0)
  estado       String    @default("PENDIENTE")
  metodoPago   String?
  dataPago     DateTime?
  observacoes  String?
  createdAt    DateTime  @default(now())
  cuota        Cuota     @relation(fields: [cuotaId], references: [id], onDelete: Cascade)
  jogador      Jogador   @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  temporada    Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  @@unique([jogadorId, cuotaId])
}

model Ingresso {
  id             Int       @id @default(autoincrement())
  temporadaId    Int
  data           DateTime
  categoria      String
  conceito       String
  importe        Float
  entidade       String?
  jornadaId      Int?
  referenciaTipo String?
  referenciaId   Int?
  documento      String?
  observacoes    String?
  createdAt      DateTime  @default(now())
  jornada        Jornada?  @relation(fields: [jornadaId], references: [id])
  temporada      Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
}

model Gasto {
  id            Int       @id @default(autoincrement())
  temporadaId   Int
  jornadaId     Int?
  data          DateTime
  categoria     String
  conceito      String
  importe       Float
  proveedor     String?
  numeroFactura String?
  documento     String?
  observacoes   String?
  createdAt     DateTime  @default(now())
  jornada       Jornada?  @relation(fields: [jornadaId], references: [id])
  temporada     Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
}

model ParticipanteJornada {
  id                Int       @id @default(autoincrement())
  jornadaId         Int
  jogadorId         Int
  temporadaId       Int
  gastosIndividuais Float     @default(0)
  observacoes       String?
  createdAt         DateTime  @default(now())
  jogador           Jogador   @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  jornada            Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  temporada         Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  @@unique([jornadaId, jogadorId])
}

model PatrocinioFinanciero {
  id              Int              @id @default(autoincrement())
  patrocinioId    Int?             @unique
  temporadaId     Int
  empresa         String
  importeTotal    Float
  importeRecebido Float            @default(0)
  estado          String           @default("PENDIENTE")
  dataCompromiso  DateTime?
  dataRecepcion   DateTime?
  documento       String?
  observacoes     String?
  createdAt       DateTime         @default(now())
  patrocinio      Patrocinio?      @relation(fields: [patrocinioId], references: [id])
  temporada       Temporada        @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
}

model SubvencionFinanceira {
  id                Int                @id @default(autoincrement())
  subvencionId      Int?               @unique
  temporadaId       Int
  organismo         String
  tipoAyuda         String
  importeSolicitado Float
  importeConcedido  Float              @default(0)
  importeRecebido   Float              @default(0)
  estado            String             @default("SOLICITADA")
  dataSolicitud     DateTime?
  dataConcesion     DateTime?
  dataRecepcion     DateTime?
  documento         String?
  observacoes       String?
  createdAt         DateTime            @default(now())
  subvencion        Subvencion?         @relation(fields: [subvencionId], references: [id])
  temporada         Temporada           @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
}

model PremioReconocimiento {
  id           Int      @id @default(autoincrement())
  ano          Int
  valor        String
  entidad      String
  premio       String
  descripcion  String?
  logo         String?
  createdAt    DateTime @default(now())
}